    {
      "id": 19,
      "type": "table",
      "title": "Dead-letter topics",
      "description": "retained = records in the topic (30 days); pending = not yet replayed (see Dead letters pending). Red when pending > 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (kafka_topic_partition_current_offset{job=\"kafka\", topic=~\".*[.]dlq\"} - kafka_topic_partition_oldest_offset{job=\"kafka\", topic=~\".*[.]dlq\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(clamp_min(sum by (topic) (kafka_consumergroup_lag_sum{job=\"kafka\", consumergroup=~\".*dlq-replay[.].*\", topic=~\".*[.]dlq\"}), 0)) or (sum by (topic) (kafka_topic_partition_current_offset{job=\"kafka\", topic=~\".*[.]dlq\"} - kafka_topic_partition_oldest_offset{job=\"kafka\", topic=~\".*[.]dlq\"}))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "topic",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "retained",
              "Value #B": "pending",
              "topic": "topic"
            },
            "indexByName": {
              "topic": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pending"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
