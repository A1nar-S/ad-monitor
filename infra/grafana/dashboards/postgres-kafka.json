    {
      "id": 15,
      "type": "bargauge",
      "title": "Biggest tables",
      "description": "Table (with TOAST) plus indexes, top 8.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, pg_stat_user_tables_table_size_bytes{job=\"postgres\"} + pg_stat_user_tables_index_size_bytes{job=\"postgres\"})",
