      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(container_spec_memory_limit_bytes{container_label_com_docker_compose_project=~\"$project\"} == 0 or container_spec_memory_limit_bytes{container_label_com_docker_compose_project=~\"$project\"} >= 1e15) or vector(0)",
          "legendFormat": "no limit",
          "instant": true
