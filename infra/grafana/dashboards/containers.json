    {
      "id": 7,
      "type": "stat",
      "title": "Without memory limit",
      "description": "Containers with no memory limit (compose sets none): they can grow until the Docker VM runs out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 3
