      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"$project\"})",
          "legendFormat": "containers",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "no data (cAdvisor down?)",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "no data (cAdvisor down?)",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
