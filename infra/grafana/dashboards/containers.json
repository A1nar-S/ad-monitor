    {
      "id": 6,
      "type": "stat",
      "title": "Containers seen",
      "description": "Docker containers cAdvisor reports in the selected project(s), not filtered by the service variable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 3
